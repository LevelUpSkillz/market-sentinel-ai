# Development only. Copy to .env and load with your shell or process manager.
ENVIRONMENT=development
DATABASE_URL=sqlite:///sentinel.dev.db
APP_ORIGIN=http://localhost:3000
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=
# Generate interactively: python scripts/setup_owner.py
OWNER_PASSWORD_HASH=
COLLECT_MARKETS=false
# Only providers whose documented terms permit the intended use:
APPROVED_PROVIDERS=
# ChangeNOW public business API key, never a wallet/private key.
CHANGENOW_API_KEY=
CHANGENOW_RESEARCH_APPROVED=false
# Private, unpredictable topic; mobile delivery disabled until configured.
NTFY_TOPIC=
NTFY_TOKEN=
